# Copie este arquivo para .env e preencha o token do seu bot.
# Só o TELEGRAM_API_TOKEN é obrigatório; o resto já tem padrão no código.

TELEGRAM_API_TOKEN=coloque_aqui_o_token_do_seu_bot

# Endereço do servidor FastAPI (server.py)
SERVER_URL=http://127.0.0.1:8000

# Modelo carregado no Jan, sempre com o prefixo openai/
# (se o modelo foi baixado como .gguf, acrescente .gguf ao final do nome)
LLM_MODEL=openai/gemma-4-E2B-it-IQ4_XS

# Endereço da API local do Jan (Local API Server)
LLM_API_BASE=http://localhost:1337/v1

# Tamanho do modelo do Whisper: tiny, base, small, medium ou large
WHISPER_MODEL=tiny

# Detalhe dos logs no terminal:
#   DEBUG   mostra também o raciocínio do modelo em cada tentativa
#   INFO    padrão: o andamento de cada pergunta
#   WARNING a linha de resumo por pergunta, mais avisos e erros
#   ERROR   só a linha de resumo por pergunta (bom para rodar em lote)
LOG_LEVEL=INFO
